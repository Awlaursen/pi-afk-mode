{
  "name": "pi-afk-mode",
  "version": "0.1.0",
  "description": "Pi extension: /afk keeps the agent working until every remaining item is blocked on a human decision. Pauses while async pi-subagents run.",
  "type": "module",
  "license": "MIT",
  "author": "Albert Laursen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Awlaursen/pi-afk-mode.git"
  },
  "homepage": "https://github.com/Awlaursen/pi-afk-mode#readme",
  "bugs": {
    "url": "https://github.com/Awlaursen/pi-afk-mode/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "afk",
    "autonomous",
    "auto-continue",
    "subagents"
  ],
  "files": [
    "afk.ts",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./afk.ts"
    ]
  },
  "scripts": {
    "test": "node --test afk.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^22.20.2",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  }
}
